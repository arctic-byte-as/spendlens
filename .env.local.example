NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # Settings > API Keys > Publishable key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...                   # Settings > API Keys > Secret key (server-side only)
# Legacy (still accepted as fallback until end of 2026):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Stripe billing — get these from dashboard.stripe.com (use sk_test_... / whsec_... for local dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...          # from: stripe listen --forward-to localhost:3000/api/webhooks/stripe
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Error observability (Epic 5-A) — get a DSN from sentry.io > Settings > Client Keys.
# Unset by default: Sentry.init() is a safe no-op without a dsn, so the app runs fine
# without these. SENTRY_DSN covers server + edge; NEXT_PUBLIC_SENTRY_DSN covers the
# browser bundle (public by design — Sentry DSNs are not secret).
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Optional — only needed to upload source maps on build:
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...
